<?xml version="1.0" encoding="utf-8"?>
<!-- Launch splash before Android 12: the DynaOps icon centred on the icon's
     own navy, so the two blend into one surface. Android 12+ uses the
     SplashScreen settings in values-v31 instead. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
